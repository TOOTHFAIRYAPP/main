<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% render 'tf-seo' %}
  {%- if settings.smart_app_banner and settings.app_store_url != blank -%}
    {%- assign app_id = settings.app_store_url | split: '/id' | last | split: '?' | first -%}
    <meta name="apple-itunes-app" content="app-id={{ app_id }}">
  {%- endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  {{ 'toothfairy.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main id="MainContent">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'tf-cookie-banner' %}
  <script src="{{ 'toothfairy.js' | asset_url }}" defer></script>
</body>
</html>
