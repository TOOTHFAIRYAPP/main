<div class="tf-wrap tf-generic" style="--pt:96px;--pb:96px">
  <h1 class="tf-h2">{{ page.title | default: product.title | default: collection.title | default: article.title | default: blog.title | default: 'Page' }}</h1>
  {%- case template.name -%}
    {%- when 'page' -%}<div class="tf-generic__body">{{ page.content }}</div>
    {%- when 'article' -%}<div class="tf-generic__body">{{ article.content }}</div>
    {%- when 'product' -%}<div class="tf-generic__body">{{ product.description }}</div>
    {%- when '404' -%}<p class="tf-generic__body">That page doesn't exist. <a href="{{ routes.root_url }}">Back to Toothfairy® AI</a></p>
    {%- when 'cart' -%}<p class="tf-generic__body">Toothfairy® AI is sold through the App Store — nothing to buy here.</p>
    {%- when 'search' -%}<p class="tf-generic__body">Try the <a href="/pages/faq">FAQ</a>.</p>
  {%- endcase -%}
</div>
{% schema %}{ "name": "Generic content", "settings": [] }{% endschema %}
