<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
<nav class="tf-header"{% if section.settings.sticky %} data-sticky{% endif %} aria-label="Main">
  <a class="tf-header__logo" href="{{ routes.root_url }}"><img src="{{ 'logo-dark.svg' | asset_url }}" alt="Toothfairy" width="113" height="32"></a>
  <div class="tf-header__links">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="{% if block.settings.style != 'normal' %}is-{{ block.settings.style }}{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
    {%- endfor -%}
  </div>
  <div class="tf-header__actions">
    {%- if section.settings.cta_label != blank -%}
      <a class="tf-header__cta tf-header__cta--{{ section.settings.cta_style }}" href="{{ section.settings.cta_link | default: settings.app_store_url }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
    <details class="tf-menu" data-tf-menu>
      <summary aria-label="Menu"><span class="tf-burger" aria-hidden="true"><i></i><i></i></span></summary>
      <div class="tf-menu__panel">
        <nav class="tf-menu__links" aria-label="Menu">
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link }}" class="tf-menu__link{% if block.settings.style != 'normal' %} is-{{ block.settings.style }}{% endif %}" style="--i: {{ forloop.index }}">
              <span class="tf-menu__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <span class="tf-menu__label">{{ block.settings.label }}</span>
              <svg class="tf-menu__arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
            </a>
          {%- endfor -%}
        </nav>
        <div class="tf-menu__foot" style="--i: {{ section.blocks.size | plus: 1 }}">
          {%- if section.settings.cta_link == blank and settings.appstore_badge -%}
            {% render 'tf-appstore-badge', size: 'm' %}<span class="tf-menu__note">Free on iPhone</span>
          {%- elsif section.settings.cta_label != blank -%}
            <a class="tf-btn tf-btn--primary tf-menu__cta" href="{{ section.settings.cta_link | default: settings.app_store_url }}"><span>{{ section.settings.cta_label }}</span><span class="tf-dot" aria-hidden="true"></span></a>
          {%- endif -%}
        </div>
      </div>
    </details>
    {%- endif -%}
  </div>
</nav>
</div>

{% schema %}
{
  "name": "TF Header",
  "tag": "section",
  "class": "tf-section tf-section--header",
  "settings": [
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "App Store"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Button link",
      "info": "Empty = App Store link from theme settings. Use #pro-demo to jump to a section."
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Pink"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stay at the top while scrolling",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Lets menu links jump here, e.g. #how. Leave empty for none."
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Line above section",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Menu link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link",
          "default": "/",
          "info": "A page (/pages/faq) or an anchor on this page (#how)."
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "accent",
              "label": "Pink"
            },
            {
              "value": "current",
              "label": "Current page (dark)"
            }
          ],
          "default": "normal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TF Header",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "For patients",
            "link": "/"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "For professionals",
            "link": "/pages/professionals"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "FAQ",
            "link": "/pages/faq"
          }
        }
      ]
    }
  ]
}
{% endschema %}
