<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
{%- assign s = section.settings -%}
{%- assign has_toc = false -%}{%- if section.blocks.size > 1 and s.show_toc -%}{%- assign has_toc = true -%}{%- endif -%}
<div class="tf-doc{% unless has_toc %} tf-doc--plain{% endunless %}">
  {%- if has_toc -%}
  <nav class="tf-doc__toc" aria-label="{{ s.toc_label | escape }}">
    <div class="tf-doc__toc-label">{{ s.toc_label }}</div>
    <ol>
      {%- for block in section.blocks -%}<li><a href="#{{ section.id }}-{{ forloop.index }}">{{ block.settings.heading }}</a></li>{%- endfor -%}
    </ol>
  </nav>
  {%- endif -%}
  <div class="tf-doc__body">
    {%- if s.updated != blank -%}<p class="tf-doc__updated">{{ s.updated }}</p>{%- endif -%}
    {%- if s.intro != blank -%}<div class="tf-doc__intro tf-rte">{{ s.intro }}</div>{%- endif -%}
    {%- for block in section.blocks -%}
      <section class="tf-doc__part" id="{{ section.id }}-{{ forloop.index }}" {{ block.shopify_attributes }}>
        <h2 class="tf-doc__h"><span class="tf-doc__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{{ block.settings.heading }}</h2>
        <div class="tf-doc__text tf-rte">{{ block.settings.text }}</div>
      </section>
    {%- endfor -%}
  </div>
</div>
</div>

{% schema %}
{
  "name": "TF Document",
  "tag": "section",
  "class": "tf-section",
  "settings": [
    {
      "type": "text",
      "id": "updated",
      "label": "Last updated line",
      "default": "Last updated: 12 November 2026"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "checkbox",
      "id": "show_toc",
      "label": "Show contents list",
      "default": true
    },
    {
      "type": "text",
      "id": "toc_label",
      "label": "Contents label",
      "default": "On this page"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Lets menu links jump here, e.g. #how. Leave empty for none."
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Line above section",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "Part",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TF Document",
      "blocks": [
        {
          "type": "part"
        },
        {
          "type": "part"
        }
      ]
    }
  ]
}
{% endschema %}
