{{ 'tf-professionals.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign reasons = section.blocks | where: 'type', 'reason'
  assign steps = section.blocks | where: 'type', 'step'
  assign facts = section.blocks | where: 'type', 'fact'
  assign plans = section.blocks | where: 'type', 'plan'
  assign faq_url = routes.root_url | append: '/pages/faq' | replace: '//', '/'
-%}

<div class="tfp">

  <nav class="tfp-nav" aria-label="Main">
    <a class="tfp-nav__logo" href="{{ routes.root_url }}"><img src="{{ 'logo-dark.svg' | asset_url }}" alt="Toothfairy" width="160" height="44"></a>
    <div class="tfp-nav__links">
      <a href="{{ routes.root_url }}">For patients</a>
      <a href="#pro-why">Why</a>
      <a href="#pro-flow">In the chair</a>
      <a href="#pro-pricing">Practice plans</a>
      <a href="{{ faq_url }}">FAQ</a>
    </div>
    <div class="tfp-nav__actions">
      <a class="tfp-nav__cta" href="#pro-demo">{{ s.nav_cta_label }}</a>
      <details class="tfp-nav__menu">
        <summary aria-label="Menu">
          <svg class="tfp-nav__open" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 5h14M2 13h14"/></svg>
          <svg class="tfp-nav__close" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 4l10 10M14 4L4 14"/></svg>
        </summary>
        <div class="tfp-nav__panel">
          <a href="{{ routes.root_url }}">For patients</a>
          <a href="#pro-why">Why</a>
          <a href="#pro-flow">In the chair</a>
          <a href="#pro-pricing">Practice plans</a>
          <a href="{{ faq_url }}">FAQ</a>
        </div>
      </details>
    </div>
  </nav>

  <header class="tfp-hero">
    <div>
      {%- if s.hero_eyebrow != blank -%}<div class="tfp-eyebrow">{{ s.hero_eyebrow }}</div>{%- endif -%}
      <h1 class="tfp-hero__title">{{ s.hero_heading }}</h1>
      {%- if s.hero_text != blank -%}<p class="tfp-hero__lead">{{ s.hero_text }}</p>{%- endif -%}
      <div class="tfp-hero__actions">
        <a class="tfp-btn tfp-btn--primary" href="#pro-demo"><span>{{ s.hero_primary_label }}</span><span class="tfp-dot" aria-hidden="true"></span></a>
        {%- if s.hero_secondary_label != blank -%}
          <a class="tfp-btn tfp-btn--ghost" href="#pro-flow"><span>{{ s.hero_secondary_label }}</span><span class="tfp-dot" aria-hidden="true"></span></a>
        {%- endif -%}
      </div>
    </div>
    <div class="tfp-hero__visual">
      <div class="tfp-hero__phones">
        <div class="tfp-phone tfp-phone--back"><div class="tfp-phone__screen">{% render 'tfp-screen', image: s.hero_image_back, fallback: 'screen-onboarding.png', sizes: '250px', loading: 'eager' %}</div></div>
        <div class="tfp-phone tfp-phone--front"><div class="tfp-phone__screen">{% render 'tfp-screen', image: s.hero_image_front, fallback: 'screen-result.png', sizes: '280px', loading: 'eager' %}</div></div>
      </div>
    </div>
  </header>

  {%- if reasons.size > 0 -%}
  <section id="pro-why" class="tfp-why" aria-label="Why Toothfairy">
    {%- for block in reasons -%}
      <div class="tfp-why__item" {{ block.shopify_attributes }}>
        <div class="tfp-why__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
        <h3 class="tfp-why__title">{{ block.settings.heading }}</h3>
        <p class="tfp-why__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </section>
  {%- endif -%}

  <section id="pro-flow" class="tfp-flow">
    <div>
      {%- if s.flow_eyebrow != blank -%}<div class="tfp-eyebrow">{{ s.flow_eyebrow }}</div>{%- endif -%}
      <h2 class="tfp-h2">{{ s.flow_heading }}</h2>
      <ol class="tfp-steps">
        {%- for block in steps -%}
          <li class="tfp-step" {{ block.shopify_attributes }}>
            <span class="tfp-step__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <div>
              <div class="tfp-step__title">{{ block.settings.heading }}</div>
              <div class="tfp-step__text">{{ block.settings.text }}</div>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    <div class="tfp-flow__visual">
      <div class="tfp-flow__phone"><div class="tfp-phone__screen">{% render 'tfp-screen', image: s.flow_image, fallback: 'screen-style.png', sizes: '(max-width: 600px) 80vw, 400px' %}</div></div>
    </div>
  </section>

  {%- if facts.size > 0 -%}
  <section class="tfp-facts" aria-label="Privacy and scope">
    {%- for block in facts -%}
      <div class="tfp-fact" {{ block.shopify_attributes }}>
        <div class="tfp-eyebrow">{{ block.settings.label }}</div>
        <p class="tfp-fact__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </section>
  {%- endif -%}

  <section id="pro-pricing" class="tfp-pricing">
    <div>
      <h2 class="tfp-h2">{{ s.pricing_heading }}</h2>
      {%- if s.pricing_text != blank -%}<p class="tfp-pricing__intro">{{ s.pricing_text }}</p>{%- endif -%}
    </div>
    <div class="tfp-plans">
      {%- for block in plans -%}
        {%- assign b = block.settings -%}
        <div class="tfp-plan{% if b.highlight %} tfp-plan--highlight{% endif %}" {{ block.shopify_attributes }}>
          <span class="tfp-plan__name">{{ b.name }}</span>
          <span class="tfp-plan__desc">{{ b.description }}</span>
          <span class="tfp-plan__action">
            {%- case b.action_style -%}
              {%- when 'link' -%}<a class="tfp-plan__link" href="{{ b.action_link | default: '#pro-demo' }}">{{ b.action_text }}</a>
              {%- when 'note' -%}<span class="tfp-plan__note">{{ b.action_text }}</span>
              {%- else -%}<span class="tfp-plan__price">{{ b.action_text }}</span>
            {%- endcase -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <section id="pro-demo" class="tfp-demo">
    <div>
      <img class="tfp-demo__symbol" src="{{ 'symbol-white.svg' | asset_url }}" alt="" width="72" height="72">
      <h2 class="tfp-demo__title">{{ s.demo_heading }}</h2>
      {%- if s.demo_text != blank -%}<p class="tfp-demo__text">{{ s.demo_text }}</p>{%- endif -%}
      {%- if s.demo_email != blank -%}
        <div class="tfp-demo__alt">Prefer email? <a href="mailto:{{ s.demo_email }}">{{ s.demo_email }}</a></div>
      {%- endif -%}
    </div>

    {%- form 'contact', id: 'demo-form', data-tfp-demo-form: '' -%}
      {%- if form.posted_successfully? -%}
        <div class="tfp-sent" role="status" tabindex="-1" data-tfp-sent>
          <div class="tfp-eyebrow">Request received</div>
          <h3 class="tfp-sent__title">Thanks<span data-tfp-name></span>. We'll be in touch within one working day.</h3>
          <p class="tfp-sent__text">You'll get a calendar invite <span data-tfp-email>by email</span>.</p>
        </div>
      {%- else -%}
        <div class="tfp-form">
          {%- if form.errors -%}
            <div class="tfp-form__full tfp-form__errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <label class="tfp-field">Name
            <input name="contact[name]" type="text" required autocomplete="name" placeholder="Dr. Anna Jansen" value="{{ form.name }}">
          </label>
          <label class="tfp-field">Practice
            <input name="contact[Practice]" type="text" required autocomplete="organization" placeholder="Tandartspraktijk Centrum">
          </label>
          <label class="tfp-field">Work email
            <input name="contact[email]" type="email" required autocomplete="email" placeholder="anna@praktijk.nl" value="{{ form.email }}">
          </label>
          <label class="tfp-field">Phone (optional)
            <input name="contact[Phone]" type="tel" autocomplete="tel" placeholder="+31 6 …">
          </label>
          <label class="tfp-field">Role
            <select name="contact[Role]">
              <option>Dentist</option>
              <option>Orthodontist</option>
              <option>Practice manager</option>
              <option>Dental chain / DSO</option>
              <option>Other</option>
            </select>
          </label>
          <label class="tfp-field">Chairs
            <select name="contact[Chairs]">
              <option>1–2</option>
              <option>3–5</option>
              <option>6–10</option>
              <option>More than 10</option>
            </select>
          </label>
          <label class="tfp-field tfp-form__full">Anything specific you'd like to see?
            <textarea name="contact[body]" rows="3" placeholder="e.g. veneer previews, sharing results with patients, invoicing">{{ form.body }}</textarea>
          </label>
          <input type="hidden" name="contact[Subject]" value="Demo request — Toothfairy AI">
          <button type="submit" class="tfp-btn tfp-btn--primary tfp-form__full"><span>{{ s.demo_button_label }}</span><span class="tfp-dot" aria-hidden="true"></span></button>
          {%- if s.demo_legal != blank -%}<p class="tfp-form__full tfp-form__legal">{{ s.demo_legal }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endform -%}
  </section>

  <footer class="tfp-footer">
    <p class="tfp-footer__note"><strong>Important.</strong> {{ s.footer_disclaimer }}</p>
    <div class="tfp-footer__meta">
      <span>{{ s.footer_copyright }}</span>
      <div class="tfp-footer__links">
        <a href="/policies/privacy-policy">Privacy policy</a>
        <a href="/policies/terms-of-service">Terms</a>
        {%- if s.demo_email != blank -%}<a href="mailto:{{ s.demo_email }}">{{ s.demo_email }}</a>{%- endif -%}
      </div>
    </div>
  </footer>
</div>

<script>
  (function () {
    var KEY = 'tfp-demo-request';
    var form = document.querySelector('[data-tfp-demo-form]');
    if (form) {
      form.addEventListener('submit', function () {
        try {
          var name = (form.querySelector('[name="contact[name]"]') || {}).value || '';
          var email = (form.querySelector('[name="contact[email]"]') || {}).value || '';
          sessionStorage.setItem(KEY, JSON.stringify({ name: name.trim(), email: email.trim() }));
        } catch (e) {}
      });
    }
    var sent = document.querySelector('[data-tfp-sent]');
    if (!sent) return;
    try {
      var data = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      if (data) {
        var first = data.name.replace(/^Dr\.?\s+/i, '').split(/\s+/)[0];
        if (first) sent.querySelector('[data-tfp-name]').textContent = ', ' + first;
        if (data.email) sent.querySelector('[data-tfp-email]').textContent = 'at ' + data.email;
      }
    } catch (e) {}
    sent.focus({ preventScroll: true });
  })();
</script>

{% schema %}
{
  "name": "TF Professionals",
  "tag": "section",
  "class": "tfp-section",
  "settings": [
    { "type": "header", "content": "Navigation" },
    { "type": "text", "id": "nav_cta_label", "label": "Nav button label", "default": "Book a demo" },

    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "For dental professionals" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Show the outcome before the treatment plan." },
    { "type": "textarea", "id": "hero_text", "label": "Intro", "default": "Toothfairy™ AI gives patients a realistic, natural-looking preview of their enhanced smile from a single photo — in the chair, in seconds. A clearer conversation, a more confident yes." },
    { "type": "text", "id": "hero_primary_label", "label": "Primary button", "default": "Book a 20-minute demo" },
    { "type": "text", "id": "hero_secondary_label", "label": "Secondary button", "default": "See how it fits your workflow" },
    { "type": "image_picker", "id": "hero_image_back", "label": "Back phone screen", "info": "Portrait app screenshot, 472 × 992 or larger. Leave empty to use the bundled onboarding screen." },
    { "type": "image_picker", "id": "hero_image_front", "label": "Front phone screen", "info": "Leave empty to use the bundled result screen." },

    { "type": "header", "content": "In the chair" },
    { "type": "text", "id": "flow_eyebrow", "label": "Eyebrow", "default": "In the chair" },
    { "type": "text", "id": "flow_heading", "label": "Heading", "default": "Three minutes, start to finish." },
    { "type": "image_picker", "id": "flow_image", "label": "Phone screen", "info": "Leave empty to use the bundled style-picker screen." },

    { "type": "header", "content": "Practice plans" },
    { "type": "text", "id": "pricing_heading", "label": "Heading", "default": "Practice plans" },
    { "type": "textarea", "id": "pricing_text", "label": "Intro", "default": "One credit per preview. Buy packs in the app, or talk to us about volume pricing and multi-chair use." },

    { "type": "header", "content": "Book a demo" },
    { "type": "text", "id": "demo_heading", "label": "Heading", "default": "Book a demo" },
    { "type": "textarea", "id": "demo_text", "label": "Text", "default": "A 20-minute video call. We'll run a preview on a photo you choose, walk through the in-chair flow and answer pricing questions." },
    { "type": "text", "id": "demo_email", "label": "Contact email", "default": "support@ortho-clear.com" },
    { "type": "text", "id": "demo_button_label", "label": "Submit button", "default": "Request a demo" },
    { "type": "text", "id": "demo_legal", "label": "Note under the button", "default": "By submitting you agree to be contacted about Toothfairy™ AI. No newsletters." },

    { "type": "header", "content": "Footer" },
    { "type": "textarea", "id": "footer_disclaimer", "label": "Disclaimer", "default": "Toothfairy™ AI is intended for visualisation and inspiration purposes only. Results are simulated previews and should not be considered medical, dental or orthodontic advice." },
    { "type": "text", "id": "footer_copyright", "label": "Copyright line", "default": "© 2021–2026 CC Lab Technology Ltd. · Orthoclear" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason (Why)",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Reason" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "step",
      "name": "Step (In the chair)",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "fact",
      "name": "Fact card",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Label" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "plan",
      "name": "Plan row",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Plan" },
        { "type": "text", "id": "description", "label": "Description" },
        {
          "type": "select",
          "id": "action_style",
          "label": "Right column",
          "options": [
            { "value": "price", "label": "Price" },
            { "value": "link", "label": "Link" },
            { "value": "note", "label": "Note" }
          ],
          "default": "price"
        },
        { "type": "text", "id": "action_text", "label": "Right column text", "default": "€0,00" },
        { "type": "text", "id": "action_link", "label": "Link target", "default": "#pro-demo", "info": "Only used when the right column is a link." },
        { "type": "checkbox", "id": "highlight", "label": "Highlight in pink", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "TF Professionals",
      "blocks": [
        { "type": "reason", "settings": { "heading": "Shorter path to acceptance", "text": "Patients decide on what they can see. A preview of their own face makes aligners, veneers or whitening concrete instead of abstract." } },
        { "type": "reason", "settings": { "heading": "Honest expectations", "text": "Results stay natural and are clearly labelled as visualisations — never a clinical promise. Fewer surprises, fewer difficult conversations later." } },
        { "type": "reason", "settings": { "heading": "Nothing to install at the practice", "text": "Runs on any iPhone. No scanner, no software licence, no onboarding project. Buy credits, start today." } },
        { "type": "step", "settings": { "heading": "Take the photo during intake", "text": "A relaxed smile under normal operatory light is enough." } },
        { "type": "step", "settings": { "heading": "Pick the treatment you're proposing", "text": "Aligner progress, veneers upgrade or whitening boost — one tap." } },
        { "type": "step", "settings": { "heading": "Compare, animate, share", "text": "Before/after side by side, optional video, sent to the patient to discuss at home." } },
        { "type": "fact", "settings": { "label": "Privacy", "text": "Patient photos remain private and are never shared without permission. Processed under EU law by CC Lab Technology Ltd., Dublin." } },
        { "type": "fact", "settings": { "label": "Scope", "text": "Visualisation and inspiration only. Toothfairy™ AI does not diagnose, plan or replace clinical judgement — and says so to the patient." } },
        { "type": "fact", "settings": { "label": "Built by", "text": "Orthoclear — the team behind the Toothfairy™ patient app used throughout aligner treatment. Dental first, AI second." } },
        { "type": "plan", "settings": { "name": "50 credits", "description": "€1,00 per preview · in-app", "action_style": "price", "action_text": "€49,99" } },
        { "type": "plan", "settings": { "name": "Practice volume", "description": "Custom packs, invoicing, multiple devices", "action_style": "link", "action_text": "Talk to us", "action_link": "#pro-demo", "highlight": true } },
        { "type": "plan", "settings": { "name": "Orthoclear partners", "description": "Included for partner practices", "action_style": "note", "action_text": "On request" } }
      ]
    }
  ]
}
{% endschema %}
