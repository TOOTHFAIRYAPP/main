<div class="tf-page" style="max-width:1440px; margin:0 auto; background:#f4eef0; color:#1a1517; font-family:'Space Grotesk', sans-serif">

  <nav style="display:flex; justify-content:space-between; align-items:center; padding:28px 80px">
    <a href="/"><img src="{{ 'logo-dark.svg' | asset_url }}" alt="Toothfairy" style="height:44px; width:auto; display:block"></a>
    <div style="display:flex; gap:36px; font-size:15px; color:#6b5f65"><a href="/">For patients</a><a href="#pro-why">Why</a><a href="#pro-flow">In the chair</a><a href="#pro-pricing">Practice plans</a><a href="/pages/faq">FAQ</a></div>
    <a href="#pro-demo" style="background:#e6007e; color:#fff; padding:12px 22px; border-radius:8px; font-size:14px; font-weight:700">Book a demo</a>
  </nav>

  <header style="padding:96px 80px 80px; display:grid; grid-template-columns:1.1fr .9fr; gap:64px; align-items:center">
    <div>
      <div style="font-size:13px; letter-spacing:.2em; text-transform:uppercase; color:#e6007e; margin-bottom:28px">For dental professionals</div>
      <h1 style="font-weight:500; font-size:84px; line-height:.95; letter-spacing:-.04em; margin:0 0 28px; text-wrap:balance">Show the outcome before the treatment plan.</h1>
      <p style="font-size:20px; line-height:1.5; color:#6b5f65; max-width:560px; margin:0 0 40px; text-wrap:pretty">Toothfairy™ AI gives patients a realistic, natural-looking preview of their enhanced smile from a single photo — in the chair, in seconds. A clearer conversation, a more confident yes.</p>
      <div style="display:flex; gap:12px">
        <a data-smile href="#pro-demo" style="background:#e6007e; color:#fff; padding:18px 32px; border-radius:8px; font-size:16px; font-weight:700; display:inline-flex; align-items:center; gap:12px"><span>Book a 20-minute demo</span><span data-smile-arc></span></a>
        <a data-smile-ghost href="#pro-flow" style="border:1px solid #cfc3c8; padding:18px 32px; border-radius:8px; font-size:16px; font-weight:500; display:inline-flex; align-items:center; gap:12px"><span>See how it fits your workflow</span><span data-smile-arc></span></a>
      </div>
    </div>
    <div style="display:flex; justify-content:center; gap:20px; align-items:flex-end">
      <div style="width:250px; height:520px; border-radius:40px; background:#1a1517; padding:9px; transform:rotate(-5deg) translateY(20px)">
        <div style="width:100%; height:100%; border-radius:32px; overflow:hidden; background:#fff"><img src="{{ 'screen-onboarding.png' | asset_url }}" alt="" style="width:100%; height:100%; object-fit:cover; object-position:top; display:block"></div>
      </div>
      <div style="width:280px; height:580px; border-radius:44px; background:#1a1517; padding:10px; box-shadow:0 40px 100px rgba(230,0,126,.18)">
        <div style="width:100%; height:100%; border-radius:36px; overflow:hidden; background:#fff"><img src="{{ 'screen-result.png' | asset_url }}" alt="" style="width:100%; height:100%; object-fit:cover; object-position:top; display:block"></div>
      </div>
    </div>
  </header>

  <section id="pro-why" style="padding:96px 80px; border-top:1px solid #e3d9dd">
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0">
      <div style="padding:0 40px 0 0; border-right:1px solid #e3d9dd; display:flex; flex-direction:column; gap:20px">
        <div style="font-size:13px; letter-spacing:.2em; color:#e6007e">01</div>
        <h3 style="margin:0; font-size:30px; font-weight:500; letter-spacing:-.02em; line-height:1.1">Shorter path to acceptance</h3>
        <p style="margin:0; color:#6b5f65; line-height:1.6; font-size:16px">Patients decide on what they can see. A preview of their own face makes aligners, veneers or whitening concrete instead of abstract.</p>
      </div>
      <div style="padding:0 40px; border-right:1px solid #e3d9dd; display:flex; flex-direction:column; gap:20px">
        <div style="font-size:13px; letter-spacing:.2em; color:#e6007e">02</div>
        <h3 style="margin:0; font-size:30px; font-weight:500; letter-spacing:-.02em; line-height:1.1">Honest expectations</h3>
        <p style="margin:0; color:#6b5f65; line-height:1.6; font-size:16px">Results stay natural and are clearly labelled as visualisations — never a clinical promise. Fewer surprises, fewer difficult conversations later.</p>
      </div>
      <div style="padding:0 0 0 40px; display:flex; flex-direction:column; gap:20px">
        <div style="font-size:13px; letter-spacing:.2em; color:#e6007e">03</div>
        <h3 style="margin:0; font-size:30px; font-weight:500; letter-spacing:-.02em; line-height:1.1">Nothing to install at the practice</h3>
        <p style="margin:0; color:#6b5f65; line-height:1.6; font-size:16px">Runs on any iPhone. No scanner, no software licence, no onboarding project. Buy credits, start today.</p>
      </div>
    </div>
  </section>

  <section id="pro-flow" style="margin:0 80px; padding:96px; border-radius:24px; background:#fff; display:grid; grid-template-columns:.9fr 1.1fr; gap:80px; align-items:center">
    <div>
      <div style="font-size:13px; letter-spacing:.2em; text-transform:uppercase; color:#e6007e; margin-bottom:24px">In the chair</div>
      <h2 style="font-weight:500; font-size:52px; line-height:1; letter-spacing:-.03em; margin:0 0 40px">Three minutes, start to finish.</h2>
      <div style="display:flex; flex-direction:column">
        <div style="display:grid; grid-template-columns:48px 1fr; gap:20px; padding:20px 0; border-top:1px solid #e3d9dd"><span style="color:#e6007e; font-size:14px; letter-spacing:.1em">01</span><div><div style="font-size:19px; font-weight:500; margin-bottom:6px">Take the photo during intake</div><div style="color:#6b5f65; font-size:15px; line-height:1.55">A relaxed smile under normal operatory light is enough.</div></div></div>
        <div style="display:grid; grid-template-columns:48px 1fr; gap:20px; padding:20px 0; border-top:1px solid #e3d9dd"><span style="color:#e6007e; font-size:14px; letter-spacing:.1em">02</span><div><div style="font-size:19px; font-weight:500; margin-bottom:6px">Pick the treatment you're proposing</div><div style="color:#6b5f65; font-size:15px; line-height:1.55">Aligner progress, veneers upgrade or whitening boost — one tap.</div></div></div>
        <div style="display:grid; grid-template-columns:48px 1fr; gap:20px; padding:20px 0; border-top:1px solid #e3d9dd"><span style="color:#e6007e; font-size:14px; letter-spacing:.1em">03</span><div><div style="font-size:19px; font-weight:500; margin-bottom:6px">Compare, animate, share</div><div style="color:#6b5f65; font-size:15px; line-height:1.55">Before/after side by side, optional video, sent to the patient to discuss at home.</div></div></div>
      </div>
    </div>
    <div style="border-radius:16px; overflow:hidden; background:#fbdfec; padding:40px 80px 0; box-sizing:border-box; height:620px">
      <div style="width:100%; height:100%; border-radius:36px 36px 0 0; background:#1a1517; padding:10px 10px 0; box-sizing:border-box"><div style="width:100%; height:100%; border-radius:28px 28px 0 0; overflow:hidden; background:#fff"><img src="{{ 'screen-style.png' | asset_url }}" alt="" style="width:100%; height:100%; object-fit:cover; object-position:top; display:block"></div></div>
    </div>
  </section>

  <section style="padding:120px 80px 96px; display:grid; grid-template-columns:repeat(3,1fr); gap:24px">
    <div style="border:1px solid #e3d9dd; border-radius:16px; padding:36px; display:flex; flex-direction:column; gap:12px">
      <div style="font-size:13px; letter-spacing:.2em; text-transform:uppercase; color:#e6007e">Privacy</div>
      <p style="margin:0; font-size:17px; line-height:1.55">Patient photos remain private and are never shared without permission. Processed under EU law by CC Lab Technology Ltd., Dublin.</p>
    </div>
    <div style="border:1px solid #e3d9dd; border-radius:16px; padding:36px; display:flex; flex-direction:column; gap:12px">
      <div style="font-size:13px; letter-spacing:.2em; text-transform:uppercase; color:#e6007e">Scope</div>
      <p style="margin:0; font-size:17px; line-height:1.55">Visualisation and inspiration only. Toothfairy™ AI does not diagnose, plan or replace clinical judgement — and says so to the patient.</p>
    </div>
    <div style="border:1px solid #e3d9dd; border-radius:16px; padding:36px; display:flex; flex-direction:column; gap:12px">
      <div style="font-size:13px; letter-spacing:.2em; text-transform:uppercase; color:#e6007e">Built by</div>
      <p style="margin:0; font-size:17px; line-height:1.55">Orthoclear — the team behind the Toothfairy™ patient app used throughout aligner treatment. Dental first, AI second.</p>
    </div>
  </section>

  <section id="pro-pricing" style="padding:96px 80px; border-top:1px solid #e3d9dd; display:grid; grid-template-columns:.8fr 1.2fr; gap:80px">
    <div>
      <h2 style="font-weight:500; font-size:52px; line-height:1; letter-spacing:-.03em; margin:0 0 24px">Practice plans</h2>
      <p style="font-size:17px; line-height:1.6; color:#6b5f65; margin:0">One credit per preview. Buy packs in the app, or talk to us about volume pricing and multi-chair use.</p>
    </div>
    <div style="display:flex; flex-direction:column">
      <div style="display:grid; grid-template-columns:1fr 1fr auto; align-items:baseline; gap:24px; padding:28px 0; border-top:1px solid #e3d9dd"><span style="font-size:22px">50 credits</span><span style="color:#6b5f65">€1,00 per preview · in-app</span><span style="font-size:32px; font-weight:500">€49,99</span></div>
      <div style="display:grid; grid-template-columns:1fr 1fr auto; align-items:baseline; gap:24px; padding:28px 0; border-top:1px solid #e3d9dd; color:#e6007e"><span style="font-size:22px">Practice volume</span><span style="color:#6b5f65">Custom packs, invoicing, multiple devices</span><a href="#pro-demo" style="font-size:16px; font-weight:700; border-bottom:2px solid #e6007e">Talk to us</a></div>
      <div style="display:grid; grid-template-columns:1fr 1fr auto; align-items:baseline; gap:24px; padding:28px 0; border-top:1px solid #e3d9dd; border-bottom:1px solid #e3d9dd"><span style="font-size:22px">Orthoclear partners</span><span style="color:#6b5f65">Included for partner practices</span><span style="font-size:16px; color:#6b5f65">On request</span></div>
    </div>
  </section>

  <section id="pro-demo" style="margin:0 80px 96px; padding:96px; border-radius:24px; background:#1a1517; color:#fcfaf8; display:grid; grid-template-columns:.9fr 1.1fr; gap:80px; align-items:start">
    <div>
      <img src="{{ 'symbol-white.svg' | asset_url }}" alt="" style="width:72px; height:72px; margin-bottom:32px; display:block">
      <h2 style="font-weight:500; font-size:56px; line-height:.98; letter-spacing:-.03em; margin:0 0 24px">Book a demo</h2>
      <p style="font-size:17px; line-height:1.6; color:#b8adb2; margin:0 0 40px; text-wrap:pretty">A 20-minute video call. We'll run a preview on a photo you choose, walk through the in-chair flow and answer pricing questions.</p>
      <div style="display:flex; flex-direction:column; gap:12px; font-size:15px; color:#b8adb2"><span>Prefer email? <a href="mailto:support@ortho-clear.com" style="color:#fcfaf8; border-bottom:1px solid #6b5f65">support@ortho-clear.com</a></span></div>
    </div>
    {% form 'contact', id: 'demo-form' %}{% if form.posted_successfully? %}<div style="border:1px solid #3a3135; border-radius:16px; padding:48px; display:flex; flex-direction:column; gap:16px; min-height:420px; justify-content:center"><div style="font-size:13px; letter-spacing:.2em; text-transform:uppercase; color:#e6007e">Request received</div><h3 style="margin:0; font-size:32px; font-weight:500; letter-spacing:-.02em">Thanks. We'll be in touch within one working day with a calendar invite.</h3></div>{% else %}<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px">{% if form.errors %}<div style="grid-column:1 / -1; color:#e6007e; font-size:14px">{{ form.errors | default_errors }}</div>{% endif %}
<label style="display:flex; flex-direction:column; gap:8px; font-size:13px; color:#b8adb2">Name<input name="contact[name]" type="text" required placeholder="Dr. Anna Jansen" style="background:#2a2326; border:1px solid #3a3135; color:#fcfaf8; border-radius:8px; padding:16px; font-size:16px; outline:none; box-sizing:border-box; width:100%"></label>
<label style="display:flex; flex-direction:column; gap:8px; font-size:13px; color:#b8adb2">Practice<input name="contact[Practice]" type="text" required placeholder="Tandartspraktijk Centrum" style="background:#2a2326; border:1px solid #3a3135; color:#fcfaf8; border-radius:8px; padding:16px; font-size:16px; outline:none; box-sizing:border-box; width:100%"></label>
<label style="display:flex; flex-direction:column; gap:8px; font-size:13px; color:#b8adb2">Work email<input name="contact[email]" type="email" required placeholder="anna@praktijk.nl" style="background:#2a2326; border:1px solid #3a3135; color:#fcfaf8; border-radius:8px; padding:16px; font-size:16px; outline:none; box-sizing:border-box; width:100%"></label>
<label style="display:flex; flex-direction:column; gap:8px; font-size:13px; color:#b8adb2">Phone (optional)<input name="contact[Phone]" type="tel" placeholder="+31 6 …" style="background:#2a2326; border:1px solid #3a3135; color:#fcfaf8; border-radius:8px; padding:16px; font-size:16px; outline:none; box-sizing:border-box; width:100%"></label>
<label style="display:flex; flex-direction:column; gap:8px; font-size:13px; color:#b8adb2">Role<select name="contact[Role]" style="background:#2a2326; border:1px solid #3a3135; color:#fcfaf8; border-radius:8px; padding:16px; font-size:16px; outline:none; box-sizing:border-box; width:100%"><option>Dentist</option><option>Orthodontist</option><option>Practice manager</option><option>Dental chain / DSO</option><option>Other</option></select></label>
<label style="display:flex; flex-direction:column; gap:8px; font-size:13px; color:#b8adb2">Chairs<select name="contact[Chairs]" style="background:#2a2326; border:1px solid #3a3135; color:#fcfaf8; border-radius:8px; padding:16px; font-size:16px; outline:none; box-sizing:border-box; width:100%"><option>1–2</option><option>3–5</option><option>6–10</option><option>More than 10</option></select></label>
<label style="grid-column:1 / -1; display:flex; flex-direction:column; gap:8px; font-size:13px; color:#b8adb2">Anything specific you'd like to see?<textarea name="contact[body]" rows="4" placeholder="e.g. veneer previews, sharing results with patients, invoicing" style="background:#2a2326; border:1px solid #3a3135; color:#fcfaf8; border-radius:8px; padding:16px; font-size:16px; outline:none; resize:vertical; box-sizing:border-box; width:100%"></textarea></label>
<input type="hidden" name="contact[Subject]" value="Demo request — Toothfairy AI">
<button type="submit" data-smile style="grid-column:1 / -1; background:#e6007e; color:#fff; border:0; padding:20px; border-radius:8px; font-size:16px; font-weight:700; cursor:pointer; margin-top:8px; display:inline-flex; align-items:center; justify-content:center; gap:12px"><span>Request a demo</span><span data-smile-arc></span></button>
<p style="grid-column:1 / -1; margin:0; font-size:13px; color:#6b5f65; line-height:1.5">By submitting you agree to be contacted about Toothfairy™ AI. No newsletters.</p></div>{% endif %}{% endform %}
  </section>

  <footer style="padding:40px 80px 56px; border-top:1px solid #e3d9dd; display:grid; grid-template-columns:1fr 1fr; gap:48px; font-size:13px; color:#6b5f65; line-height:1.6">
    <p style="margin:0; text-wrap:pretty"><strong style="color:#1a1517">Important.</strong> Toothfairy™ AI is intended for visualisation and inspiration purposes only. Results are simulated previews and should not be considered medical, dental or orthodontic advice.</p>
    <div style="display:flex; flex-direction:column; gap:8px; align-items:flex-end"><span>© 2021–2026 CC Lab Technology Ltd. · Orthoclear</span><div style="display:flex; gap:24px"><a href="/policies/privacy-policy">Privacy policy</a><a href="/policies/terms-of-service">Terms</a><a href="mailto:support@ortho-clear.com">support@ortho-clear.com</a></div></div>
  </footer>
</div>

