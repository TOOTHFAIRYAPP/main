<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
{%- assign s = section.settings -%}
<div class="tf-panel tf-form-panel tf-form-panel--light">
  <div>
    {%- if s.eyebrow != blank -%}<div class="tf-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="tf-h2">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<p class="tf-body">{{ s.text }}</p>{%- endif -%}
    <div class="tf-form-panel__meta">
      {%- if s.email != blank -%}<span>Email <a href="mailto:{{ s.email }}">{{ s.email }}</a></span>{%- endif -%}
      {%- if s.address != blank -%}<span>{{ s.address }}</span>{%- endif -%}
    </div>
  </div>
  {%- form 'contact', id: 'contact-form' -%}
    {%- if form.posted_successfully? -%}
      <div class="tf-sent" role="status" tabindex="-1" data-tf-sent>
        <div class="tf-eyebrow">Message sent</div>
        <h3 class="tf-sent__title">Thanks. We'll reply within one working day.</h3>
      </div>
    {%- else -%}
      <div class="tf-form">
        {%- if form.errors -%}<div class="tf-form__full tf-form__errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="tf-field">Name<input name="contact[name]" type="text" required autocomplete="name" placeholder="Your name" value="{{ form.name }}"></label>
        <label class="tf-field">Email<input name="contact[email]" type="email" required autocomplete="email" placeholder="you@example.com" value="{{ form.email }}"></label>
        <label class="tf-field tf-form__full">Topic<select name="contact[Topic]">{% assign opts = s.topics | newline_to_br | split: '<br />' %}{% for o in opts %}{% assign o = o | strip %}{% if o != blank %}<option>{{ o }}</option>{% endif %}{% endfor %}</select></label>
        <label class="tf-field tf-form__full">Message<textarea name="contact[body]" rows="4" placeholder="Tell us what happened or what you'd like to know">{{ form.body }}</textarea></label>
        <button type="submit" class="tf-btn tf-btn--primary tf-form__full"><span>{{ s.button_label }}</span><span class="tf-dot" aria-hidden="true"></span></button>
        {%- if s.legal != blank -%}<p class="tf-form__full tf-form__legal">{{ s.legal }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endform -%}
</div>
</div>

{% schema %}
{
  "name": "TF Contact form",
  "tag": "section",
  "class": "tf-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still have a question?"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 104,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We reply within one working day. For a failed preview, attach the photo you used so we can check it and restore your credit."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "default": "support@ortho-clear.com"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address line",
      "default": "CC Lab Technology Holding Limited · Merchants House, 27–30 Merchant's Quay, Dublin 8, Ireland"
    },
    {
      "type": "textarea",
      "id": "topics",
      "label": "Topic options",
      "default": "A preview didn't work\nCredits or payment\nPrivacy or my data\nUsing it in my practice\nSomething else",
      "info": "One per line."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "legal",
      "label": "Note under the button",
      "default": "We only use your details to answer your message. See our privacy policy."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "contact",
      "info": "Lets menu links jump here, e.g. #how. Leave empty for none."
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Line above section",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "TF Contact form"
    }
  ]
}
{% endschema %}
