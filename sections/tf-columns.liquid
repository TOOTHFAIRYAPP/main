<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
<div class="tf-cols{% if section.settings.show_media %} tf-cols--media{% endif %}">
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    <div class="tf-col" {{ block.shopify_attributes }}>
      <div class="tf-col__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
      <h3 class="tf-col__title">{{ b.heading }}</h3>
      <p class="tf-col__text">{{ b.text }}</p>
      {%- if section.settings.show_media -%}
        <div class="tf-col__media"><div class="tf-screen">
          {%- if b.video != blank -%}
            {{ b.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '720x' }}
          {%- elsif b.video_url != blank -%}
            <video src="{{ b.video_url }}" autoplay muted loop playsinline></video>
          {%- else -%}
            {% render 'tf-screen', image: b.media_image, fallback: b.media_screen, sizes: '320px' %}
          {%- endif -%}
        </div></div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>
</div>

{% schema %}
{
  "name": "TF Numbered columns",
  "tag": "section",
  "class": "tf-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show phone screen under each column",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Lets menu links jump here, e.g. #how. Leave empty for none."
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Line above section",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Optional. Plays muted on a loop instead of the screen."
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Or video URL (MP4)",
          "info": "Only used when no video is picked above."
        },
        {
          "type": "image_picker",
          "id": "media_image",
          "label": "Screen — image",
          "info": "Portrait screenshot. Overrides the bundled screen."
        },
        {
          "type": "select",
          "id": "media_screen",
          "label": "Screen — bundled screen",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "screen-onboarding.webp",
              "label": "App: onboarding"
            },
            {
              "value": "screen-style.webp",
              "label": "App: pick a style"
            },
            {
              "value": "screen-result.webp",
              "label": "App: result"
            },
            {
              "value": "screen-gallery.webp",
              "label": "App: gallery"
            },
            {
              "value": "screen-video.webp",
              "label": "App: AI smile video"
            }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TF Numbered columns",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
