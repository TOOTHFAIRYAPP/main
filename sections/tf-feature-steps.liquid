<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
{%- assign s = section.settings -%}
<div class="tf-panel tf-flow{% if s.reverse %} tf-flow--reverse{% endif %}">
  <div>
    {%- if s.eyebrow != blank -%}<div class="tf-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="tf-h2">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<p class="tf-body">{{ s.text }}</p>{%- endif -%}
    <ol class="tf-steps">
      {%- for block in section.blocks -%}
        <li class="tf-step" {{ block.shopify_attributes }}>
          <span class="tf-step__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <div><div class="tf-step__title">{{ block.settings.heading }}</div><div class="tf-step__text">{{ block.settings.text }}</div></div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.button_label != blank -%}
      <a class="tf-btn tf-btn--primary" href="{{ s.button_link | default: settings.app_store_url }}"><span>{{ s.button_label }}</span><span class="tf-dot" aria-hidden="true"></span></a>
    {%- endif -%}
  </div>
  <div class="tf-flow__visual"><div class="tf-flow__phone"><div class="tf-screen">{% render 'tf-screen', image: section.settings.phone_image, fallback: section.settings.phone_screen, sizes: '(max-width: 600px) 80vw, 400px' %}</div></div></div>
</div>
</div>

{% schema %}
{
  "name": "TF Steps + phone",
  "tag": "section",
  "class": "tf-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In the chair"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three minutes, start to finish."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 104,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "info": "Optional, shown under the heading."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "info": "Optional, shown under the steps. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = App Store link. Use #pro-demo to jump to the demo form."
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Phone on the left",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "phone_image",
      "label": "Phone — image",
      "info": "Portrait screenshot. Overrides the bundled screen."
    },
    {
      "type": "select",
      "id": "phone_screen",
      "label": "Phone — bundled screen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "screen-onboarding.png",
          "label": "App: onboarding"
        },
        {
          "value": "screen-style.png",
          "label": "App: pick a style"
        },
        {
          "value": "screen-result.png",
          "label": "App: result"
        },
        {
          "value": "screen-gallery.png",
          "label": "App: gallery"
        }
      ],
      "default": "screen-style.png"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Lets menu links jump here, e.g. #how. Leave empty for none."
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Line above section",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Step"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TF Steps + phone",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
