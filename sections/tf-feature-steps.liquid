<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
{%- assign s = section.settings -%}
<div class="tf-panel tf-flow{% if s.reverse %} tf-flow--reverse{% endif %}">
  <div>
    {%- if s.eyebrow != blank -%}<div class="tf-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="tf-h2">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<p class="tf-body">{{ s.text }}</p>{%- endif -%}
    <ol class="tf-steps">
      {%- for block in section.blocks -%}
        <li class="tf-step" {{ block.shopify_attributes }}>
          <span class="tf-step__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <div><div class="tf-step__title">{{ block.settings.heading }}</div><div class="tf-step__text">{{ block.settings.text }}</div></div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.button_link == blank and settings.appstore_badge and s.button_label != blank -%}
      <div class="tf-flow__badge">{% render 'tf-appstore-badge', size: 'm' %}</div>
    {%- elsif s.button_label != blank -%}
      <a class="tf-btn tf-btn--primary" href="{{ s.button_link | default: settings.app_store_url }}"><span>{{ s.button_label }}</span><span class="tf-dot" aria-hidden="true"></span></a>
    {%- endif -%}
  </div>
  {%- if s.visual == 'photo' -%}
  <div class="tf-flow__visual tf-flow__visual--photo">
    {%- if s.photo != blank -%}
      {{ s.photo | image_url: width: 1120 | image_tag: alt: s.photo_alt, loading: 'lazy', sizes: '(max-width: 860px) 100vw, 50vw', widths: '560, 840, 1120' }}
    {%- else -%}
      <img src="{{ 'clinic-chair.webp' | asset_url }}" alt="{{ s.photo_alt | escape }}" width="1120" height="1400" loading="lazy">
    {%- endif -%}
  </div>
  {%- else -%}
  <div class="tf-flow__visual"><div class="tf-flow__phone"><div class="tf-screen">
    {%- if s.phone_video != blank -%}
      {{ s.phone_video | video_tag: autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '640x' }}
    {%- elsif s.phone_video_url != blank -%}
      <video src="{{ s.phone_video_url }}" muted loop playsinline preload="none"></video>
    {%- else -%}
      {% render 'tf-screen', image: section.settings.phone_image, fallback: section.settings.phone_screen, sizes: '(max-width: 600px) 80vw, 400px' %}
    {%- endif -%}
  </div></div></div>
  {%- endif -%}
</div>
</div>

{% schema %}
{
  "name": "TF Steps + phone",
  "tag": "section",
  "class": "tf-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In the chair"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three minutes, start to finish."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 104,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "info": "Optional, shown under the heading."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "info": "Optional, shown under the steps. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = App Store link. Use #pro-demo to jump to the demo form."
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Phone on the left",
      "default": false
    },
    {
      "type": "select",
      "id": "visual",
      "label": "Visual",
      "default": "phone",
      "options": [
        {
          "value": "phone",
          "label": "Phone with app screen"
        },
        {
          "value": "photo",
          "label": "Photo"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Photo",
      "info": "Used when Visual is Photo. Empty = bundled treatment-chair photo. Portrait works best."
    },
    {
      "type": "text",
      "id": "photo_alt",
      "label": "Photo description (alt text)",
      "default": "Patient in the treatment chair holding a clear aligner"
    },
    {
      "type": "image_picker",
      "id": "phone_image",
      "label": "Phone — image",
      "info": "Portrait screenshot. Overrides the bundled screen."
    },
    {
      "type": "select",
      "id": "phone_screen",
      "label": "Phone — bundled screen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "screen-onboarding.webp",
          "label": "App: onboarding"
        },
        {
          "value": "screen-style.webp",
          "label": "App: pick a style"
        },
        {
          "value": "screen-result.webp",
          "label": "App: result"
        },
        {
          "value": "screen-gallery.webp",
          "label": "App: gallery"
        },
        {
          "value": "screen-video.webp",
          "label": "App: AI smile video"
        }
      ],
      "default": "screen-style.webp"
    },
    {
      "type": "video",
      "id": "phone_video",
      "label": "Phone — video",
      "info": "Plays muted on a loop instead of the phone screen. Full-screen portrait recording works best."
    },
    {
      "type": "url",
      "id": "phone_video_url",
      "label": "Phone — or video URL (MP4)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Lets menu links jump here, e.g. #how. Leave empty for none."
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Line above section",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Step"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TF Steps + phone",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
