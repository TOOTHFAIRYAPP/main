<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
{%- assign s = section.settings -%}
<div class="tf-ba__head">
  <h2 class="tf-h2">{{ s.heading }}</h2>
  {%- if s.text != blank -%}<p class="tf-body">{{ s.text }}</p>{%- endif -%}
</div>
{%- if s.layout == 'cards' -%}
<div class="tf-ba-cards" data-tf-slider>
  {%- for i in (1..3) -%}
    {%- liquid
      case i
        when 1
          assign t = s.tab_1
          assign d = s.desc_1
          assign note = s.note_1
          assign img = s.card_after_1
          assign fb = 'teeth-card-after.webp'
        when 2
          assign t = s.tab_2
          assign d = s.desc_2
          assign note = s.note_2
          assign img = s.card_after_2
          assign fb = 'teeth-card-after-whitening.webp'
        when 3
          assign t = s.tab_3
          assign d = s.desc_3
          assign note = s.note_3
          assign img = s.card_after_3
          assign fb = 'teeth-card-after-aligners.webp'
      endcase
    -%}
    {%- if t != blank -%}
    <figure class="tf-ba-card">
      <div class="tf-ba tf-ba--card" data-tf-ba>
        <div class="tf-ba__img">{% render 'tf-screen', image: s.card_before, fallback: 'teeth-card-before.webp', alt: s.before_label, width: 960, height: 720, sizes: '(min-width: 861px) 33vw, 84vw' %}</div>
        <div class="tf-ba__img tf-ba__img--after">{% render 'tf-screen', image: img, fallback: fb, alt: t, width: 960, height: 720, sizes: '(min-width: 861px) 33vw, 84vw' %}</div>
        <div class="tf-ba__line"></div>
        <div class="tf-ba__handle" aria-hidden="true">{% render 'tf-face' %}</div>
        <input class="tf-ba__range" type="range" min="0" max="100" value="50" aria-label="Compare before and after: {{ t | escape }}">
        <span class="tf-ba__label tf-ba__label--before">{{ s.before_label }}</span>
        <span class="tf-ba__label tf-ba__label--after">{{ s.after_label }}</span>
      </div>
      <figcaption class="tf-ba-card__cap">
        <span class="tf-ba-card__num">0{{ i }}</span>
        <strong class="tf-ba-card__title">{{ t }}</strong>
        {%- if d != blank -%}<span class="tf-ba-card__text">{{ d }}</span>{%- endif -%}
        {%- if note != blank -%}<small class="tf-ba-card__note">{{ note }}</small>{%- endif -%}
      </figcaption>
    </figure>
    {%- endif -%}
  {%- endfor -%}
</div>
{%- else -%}
{%- assign has_tabs = false -%}
{%- if s.tab_1 != blank and s.tab_2 != blank -%}{%- assign has_tabs = true -%}{%- endif -%}
{%- if has_tabs -%}
<div class="tf-ba__tabs" role="group" aria-label="Treatment">
  <button type="button" class="tf-ba__tab is-active" aria-pressed="true">{{ s.tab_1 }}</button>
  <button type="button" class="tf-ba__tab" aria-pressed="false">{{ s.tab_2 }}</button>
  {%- if s.tab_3 != blank -%}<button type="button" class="tf-ba__tab" aria-pressed="false">{{ s.tab_3 }}</button>{%- endif -%}
</div>
{%- endif -%}
<div class="tf-ba" data-tf-ba>
  <div class="tf-ba__img">{% render 'tf-screen', image: s.before_image, fallback: 'teeth-before.webp', alt: s.before_label, width: 1254, height: 627, sizes: '(min-width: 1440px) 1280px, 100vw' %}</div>
  <div class="tf-ba__img tf-ba__img--after">
    <div class="tf-ba__after is-active">{% render 'tf-screen', image: s.after_image, fallback: 'teeth-after.webp', alt: s.after_label, width: 1254, height: 627, sizes: '(min-width: 1440px) 1280px, 100vw' %}</div>
    {%- if has_tabs -%}
    <div class="tf-ba__after">{% render 'tf-screen', image: s.after_image_2, fallback: 'teeth-after-whitening.webp', alt: s.after_label, width: 1254, height: 627, loading: 'lazy', sizes: '(min-width: 1440px) 1280px, 100vw' %}</div>
    {%- if s.tab_3 != blank -%}
    <div class="tf-ba__after">{% render 'tf-screen', image: s.after_image_3, fallback: 'teeth-after-aligners.webp', alt: s.after_label, width: 1254, height: 627, loading: 'lazy', sizes: '(min-width: 1440px) 1280px, 100vw' %}</div>
    {%- endif -%}
    {%- endif -%}
  </div>
  <div class="tf-ba__line"></div>
  <div class="tf-ba__handle" aria-hidden="true">{% render 'tf-face' %}</div>
  <input class="tf-ba__range" type="range" min="0" max="100" value="50" aria-label="Compare before and after">
  <span class="tf-ba__label tf-ba__label--before">{{ s.before_label }}</span>
  <span class="tf-ba__label tf-ba__label--after">{{ s.after_label }}</span>
</div>
{%- endif -%}
</div>

{% schema %}
{
  "name": "TF Before / after",
  "tag": "section",
  "class": "tf-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enhanced. Not replaced."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 104,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Drag the handle. The preview keeps your features, your expression and your proportions."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "cards",
      "options": [
        {
          "value": "cards",
          "label": "Cards (one slider per treatment)"
        },
        {
          "value": "tabs",
          "label": "One wide slider with tabs"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image",
      "info": "Empty = bundled photo. Before and after need identical framing."
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "tab_1",
      "label": "Tab 1 label",
      "default": "Veneers",
      "info": "With both tab labels filled in, visitors can switch between two after photos (same before photo)."
    },
    {
      "type": "text",
      "id": "tab_2",
      "label": "Tab 2 label",
      "default": "Whitening"
    },
    {
      "type": "image_picker",
      "id": "after_image_2",
      "label": "Tab 2 after image",
      "info": "Empty = bundled whitening photo."
    },
    {
      "type": "text",
      "id": "tab_3",
      "label": "Tab 3 label",
      "default": "Aligners",
      "info": "Optional third tab; leave empty to hide it."
    },
    {
      "type": "image_picker",
      "id": "after_image_3",
      "label": "Tab 3 after image",
      "info": "Empty = bundled aligners photo."
    },
    {
      "type": "header",
      "content": "Cards layout"
    },
    {
      "type": "paragraph",
      "content": "Card titles use the tab labels above. Card photos are 4:3; empty = bundled photos."
    },
    {
      "type": "text",
      "id": "desc_1",
      "label": "Card 1 text",
      "default": "New shape and shade with porcelain veneers."
    },
    {
      "type": "text",
      "id": "desc_2",
      "label": "Card 2 text",
      "default": "A brighter shade on your own natural teeth."
    },
    {
      "type": "text",
      "id": "desc_3",
      "label": "Card 3 text",
      "default": "Straighter alignment, same natural teeth."
    },
    {
      "type": "text",
      "id": "note_1",
      "label": "Card 1 small note"
    },
    {
      "type": "text",
      "id": "note_2",
      "label": "Card 2 small note"
    },
    {
      "type": "text",
      "id": "note_3",
      "label": "Card 3 small note",
      "default": "Composite bonding may be needed in addition to further enhance the result."
    },
    {
      "type": "image_picker",
      "id": "card_before",
      "label": "Card before image"
    },
    {
      "type": "image_picker",
      "id": "card_after_1",
      "label": "Card 1 after image"
    },
    {
      "type": "image_picker",
      "id": "card_after_2",
      "label": "Card 2 after image"
    },
    {
      "type": "image_picker",
      "id": "card_after_3",
      "label": "Card 3 after image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Lets menu links jump here, e.g. #how. Leave empty for none."
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Line above section",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "TF Before / after"
    }
  ]
}
{% endschema %}
