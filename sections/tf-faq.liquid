<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
{%- assign s = section.settings -%}
<div class="tf-split tf-faq">
  <div>
    {%- if s.eyebrow != blank -%}<div class="tf-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="tf-h2">{{ s.heading }}</h2>
  </div>
  <div class="tf-qs">
    {%- for block in section.blocks -%}
      <details class="tf-q" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
        <summary><span>{{ block.settings.question }}</span><span class="tf-q__icon" aria-hidden="true">+</span></summary>
        <div class="tf-q__a tf-rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>
</div>

{% schema %}
{
  "name": "TF FAQ",
  "tag": "section",
  "class": "tf-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional, e.g. 01."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 104,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "faq",
      "info": "Lets menu links jump here, e.g. #how. Leave empty for none."
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Line above section",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TF FAQ",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
