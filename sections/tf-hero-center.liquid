<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
{%- assign s = section.settings -%}
<div class="tf-hero-c">
  {%- if s.eyebrow != blank -%}<div class="tf-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
  <h1 class="tf-h1">{{ s.heading | newline_to_br }}</h1>
  {%- if s.text != blank -%}<p class="tf-lead">{{ s.text }}</p>{%- endif -%}
  <div class="tf-actions">
    {%- if s.primary_label != blank -%}<a class="tf-btn tf-btn--primary" href="{{ s.primary_link | default: settings.app_store_url }}"><span>{{ s.primary_label }}</span><span class="tf-dot" aria-hidden="true"></span></a>{%- endif -%}
    {%- if s.secondary_label != blank -%}<a class="tf-btn tf-btn--ghost" href="{{ s.secondary_link }}"><span>{{ s.secondary_label }}</span><span class="tf-dot" aria-hidden="true"></span></a>{%- endif -%}
  </div>
  <div class="tf-hero-c__stage">
    <div class="tf-hero-c__phones">
      <div class="tf-hero-c__glow"></div>
      <div class="tf-phone tf-phone--side tf-phone--l"><div class="tf-screen">{% render 'tf-screen', image: section.settings.left_image, fallback: section.settings.left_screen, sizes: '280px', loading: 'eager' %}</div></div>
      <div class="tf-phone tf-phone--c"><div class="tf-screen">{% render 'tf-screen', image: section.settings.center_image, fallback: section.settings.center_screen, sizes: '320px', loading: 'eager' %}</div></div>
      <div class="tf-phone tf-phone--side tf-phone--r"><div class="tf-screen">{% render 'tf-screen', image: section.settings.right_image, fallback: section.settings.right_screen, sizes: '280px', loading: 'eager' %}</div></div>
    </div>
  </div>
</div>
</div>

{% schema %}
{
  "name": "TF Hero (centred)",
  "tag": "section",
  "class": "tf-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "AI smile simulation · iPhone"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your future smile,\nfrom one selfie.",
      "info": "Line breaks are kept."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 48,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 104
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Realistic, natural-looking previews in seconds. Then watch it move in an AI-generated video."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Pink button",
      "default": "Download on the App Store"
    },
    {
      "type": "text",
      "id": "primary_link",
      "label": "Pink button link",
      "info": "Empty = App Store link."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Outline button",
      "default": "Watch the video"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Outline button link",
      "default": "#video"
    },
    {
      "type": "header",
      "content": "Phones"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left phone — image",
      "info": "Portrait screenshot. Overrides the bundled screen."
    },
    {
      "type": "select",
      "id": "left_screen",
      "label": "Left phone — bundled screen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "screen-onboarding.png",
          "label": "App: onboarding"
        },
        {
          "value": "screen-style.png",
          "label": "App: pick a style"
        },
        {
          "value": "screen-result.png",
          "label": "App: result"
        },
        {
          "value": "screen-gallery.png",
          "label": "App: gallery"
        }
      ],
      "default": "screen-onboarding.png"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Middle phone — image",
      "info": "Portrait screenshot. Overrides the bundled screen."
    },
    {
      "type": "select",
      "id": "center_screen",
      "label": "Middle phone — bundled screen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "screen-onboarding.png",
          "label": "App: onboarding"
        },
        {
          "value": "screen-style.png",
          "label": "App: pick a style"
        },
        {
          "value": "screen-result.png",
          "label": "App: result"
        },
        {
          "value": "screen-gallery.png",
          "label": "App: gallery"
        }
      ],
      "default": "screen-result.png"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right phone — image",
      "info": "Portrait screenshot. Overrides the bundled screen."
    },
    {
      "type": "select",
      "id": "right_screen",
      "label": "Right phone — bundled screen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "screen-onboarding.png",
          "label": "App: onboarding"
        },
        {
          "value": "screen-style.png",
          "label": "App: pick a style"
        },
        {
          "value": "screen-result.png",
          "label": "App: result"
        },
        {
          "value": "screen-gallery.png",
          "label": "App: gallery"
        }
      ],
      "default": "screen-gallery.png"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Lets menu links jump here, e.g. #how. Leave empty for none."
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Line above section",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "TF Hero (centred)"
    }
  ]
}
{% endschema %}
