<div class="tf-wrap{% if section.settings.border_top %} tf-wrap--border{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | remove: '#' }}"{% endif %} style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px{% if section.settings.heading_size %};--hs:{{ section.settings.heading_size }}{% endif %}">
{%- assign s = section.settings -%}
<div class="tf-hero-c">
  {%- if s.eyebrow != blank -%}
    {%- assign ticks = s.eyebrow_ticker | newline_to_br | split: '<br />' -%}
    <div class="tf-eyebrow tf-ticker" data-tf-ticker>
      <span class="tf-ticker__item is-active">{{ s.eyebrow }}</span>
      {%- for t in ticks -%}{%- assign line = t | strip -%}{%- if line != blank -%}<span class="tf-ticker__item" aria-hidden="true">{{ line }}</span>{%- endif -%}{%- endfor -%}
    </div>
  {%- endif -%}
  <h1 class="tf-h1">{{ s.heading | newline_to_br }}</h1>
  {%- if s.text != blank -%}<p class="tf-lead">{{ s.text }}</p>{%- endif -%}
  <div class="tf-actions">
    {%- if s.primary_link == blank and settings.appstore_badge -%}{% render 'tf-appstore-badge', size: 'l' %}
    {%- elsif s.primary_label != blank -%}<a class="tf-btn tf-btn--primary" href="{{ s.primary_link | default: settings.app_store_url }}"><span>{{ s.primary_label }}</span><span class="tf-dot" aria-hidden="true"></span></a>{%- endif -%}
    {%- if s.secondary_label != blank -%}<a class="tf-btn tf-btn--ghost" href="{{ s.secondary_link }}"><span>{{ s.secondary_label }}</span><span class="tf-dot" aria-hidden="true"></span></a>{%- endif -%}
  </div>
  {%- if s.show_qr -%}{% render 'tf-qr', align: 'center' %}{%- endif -%}
  <div class="tf-hero-c__stage"{% if s.fan_out %} data-tf-fan{% endif %}{% if s.tilt %} data-tf-tilt{% endif %}>
    <div class="tf-hero-c__phones">
      <div class="tf-hero-c__glow"></div>
      <div class="tf-hero-c__floor"></div>
      <div class="tf-hero-c__slot tf-hero-c__slot--l"><div class="tf-device tf-device--side"><div class="tf-screen">{% render 'tf-screen', image: section.settings.left_image, fallback: section.settings.left_screen, sizes: '280px', loading: 'eager' %}<span class="tf-device__island"></span></div></div></div>
      <div class="tf-hero-c__slot tf-hero-c__slot--c"><div class="tf-device tf-device--center"><div class="tf-screen">
        {%- if s.center_video != blank -%}
          {{ s.center_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'auto', image_size: '640x' }}
        {%- elsif s.center_video_url != blank -%}
          <video src="{{ s.center_video_url }}" autoplay muted loop playsinline></video>
        {%- else -%}
          {% render 'tf-screen', image: section.settings.center_image, fallback: section.settings.center_screen, sizes: '320px', loading: 'eager' %}
        {%- endif -%}
        <span class="tf-device__island"></span></div></div></div>
      <div class="tf-hero-c__slot tf-hero-c__slot--r"><div class="tf-device tf-device--side"><div class="tf-screen">{% render 'tf-screen', image: section.settings.right_image, fallback: section.settings.right_screen, sizes: '280px', loading: 'eager' %}<span class="tf-device__island"></span></div></div></div>
    </div>
  </div>
</div>
</div>

{% schema %}
{
  "name": "TF Hero (centred)",
  "tag": "section",
  "class": "tf-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "AI smile simulation · iPhone"
    },
    {
      "type": "textarea",
      "id": "eyebrow_ticker",
      "label": "Eyebrow — rotating lines",
      "default": "Natural results in seconds\nAligners, veneers & whitening\nWatch your new smile move\nPhotos stay on your phone\nFrom €4,99 · No subscription",
      "info": "One short line each (max ~28 characters). They take turns after the eyebrow. Leave empty for a static eyebrow."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your future smile,\nfrom one selfie.",
      "info": "Line breaks are kept."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 48,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 104
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Realistic, natural-looking previews in seconds. Then watch it move in an AI-generated video."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Pink button",
      "default": "Download on the App Store"
    },
    {
      "type": "text",
      "id": "primary_link",
      "label": "Pink button link",
      "info": "Empty = App Store link."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Outline button",
      "default": "Watch the video"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Outline button link",
      "default": "#video"
    },
    {
      "type": "header",
      "content": "Phones"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left phone — image",
      "info": "Portrait screenshot. Overrides the bundled screen."
    },
    {
      "type": "select",
      "id": "left_screen",
      "label": "Left phone — bundled screen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "screen-onboarding.webp",
          "label": "App: onboarding"
        },
        {
          "value": "screen-style.webp",
          "label": "App: pick a style"
        },
        {
          "value": "screen-result.webp",
          "label": "App: result"
        },
        {
          "value": "screen-gallery.webp",
          "label": "App: gallery"
        },
        {
          "value": "screen-video.webp",
          "label": "App: AI smile video"
        }
      ],
      "default": "screen-onboarding.webp"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Middle phone — image",
      "info": "Portrait screenshot. Overrides the bundled screen."
    },
    {
      "type": "select",
      "id": "center_screen",
      "label": "Middle phone — bundled screen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "screen-onboarding.webp",
          "label": "App: onboarding"
        },
        {
          "value": "screen-style.webp",
          "label": "App: pick a style"
        },
        {
          "value": "screen-result.webp",
          "label": "App: result"
        },
        {
          "value": "screen-gallery.webp",
          "label": "App: gallery"
        },
        {
          "value": "screen-video.webp",
          "label": "App: AI smile video"
        }
      ],
      "default": "screen-result.webp"
    },
    {
      "type": "video",
      "id": "center_video",
      "label": "Middle phone — video",
      "info": "Plays muted on a loop instead of the middle screen. Full-screen portrait recording."
    },
    {
      "type": "url",
      "id": "center_video_url",
      "label": "Middle phone — or video URL (MP4)"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right phone — image",
      "info": "Portrait screenshot. Overrides the bundled screen."
    },
    {
      "type": "select",
      "id": "right_screen",
      "label": "Right phone — bundled screen",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "screen-onboarding.webp",
          "label": "App: onboarding"
        },
        {
          "value": "screen-style.webp",
          "label": "App: pick a style"
        },
        {
          "value": "screen-result.webp",
          "label": "App: result"
        },
        {
          "value": "screen-gallery.webp",
          "label": "App: gallery"
        },
        {
          "value": "screen-video.webp",
          "label": "App: AI smile video"
        }
      ],
