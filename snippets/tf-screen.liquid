{%- comment -%}
  An image picked in the theme editor, otherwise a bundled asset.
  Params: image (image|blank), fallback (asset filename, or 'none'), alt, width + height (of the bundled file, default 472 × 992), sizes, loading
{%- endcomment -%}
{%- liquid
  assign loading = loading | default: 'lazy'
  assign sizes = sizes | default: '280px'
  assign alt = alt | default: ''
  assign width = width | default: 472
  assign height = height | default: 992
-%}
{%- if image != blank -%}
  {%- comment -%} Follow the focal point set in Shopify (Content → Files, or the image picker). Unset (centre) keeps the top of the screen, as for app screenshots. {%- endcomment -%}
  {%- assign focal = image.presentation.focal_point | default: '' -%}
  {%- if focal == blank or focal == '50.0% 50.0%' or focal == '50% 50%' -%}{%- assign focal = 'top' -%}{%- endif -%}
  {%- assign focal_style = 'object-position: ' | append: focal -%}
  {{ image | image_url: width: 1600 | image_tag: alt: alt, loading: loading, sizes: sizes, widths: '320, 480, 640, 960, 1280, 1600', style: focal_style }}
{%- elsif fallback != blank and fallback != 'none' -%}
  <img src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" loading="{{ loading }}" width="{{ width }}" height="{{ height }}">
{%- endif -%}
