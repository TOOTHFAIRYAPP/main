    "why": {
      "type": "tf-columns",
      "settings": {
        "anchor": "pro-why"
      },
      "blocks": {
        "column_1": {
          "type": "column",
          "settings": {
            "heading": "Shorter path to acceptance",
            "text": "Patients decide on what they can see. A preview of their own face makes aligners, veneers or whitening concrete instead of abstract."
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "heading": "Honest expectations",
            "text": "Results stay natural and are clearly labelled as visualisations — never a clinical promise. Fewer surprises, fewer difficult conversations later."
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "heading": "Nothing to install at the practice",
            "text": "Runs on any iPhone. No scanner, no software licence, no onboarding project. Buy credits, start today."
          }
        }
      },
      "block_order": [
        "column_1",
        "column_2",
        "column_3"
      ]
    },
    "flow": {
      "type": "tf-feature-steps",
      "settings": {
        "anchor": "pro-flow"
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "heading": "Take the photo during intake",
            "text": "A relaxed smile under normal operatory light is enough."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "heading": "Pick the treatment you're proposing",
            "text": "Aligner progress, veneers upgrade or whitening boost — one tap."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "heading": "Compare, animate, share",
            "text": "Before/after side by side, optional video, sent to the patient to discuss at home."
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
      ]
